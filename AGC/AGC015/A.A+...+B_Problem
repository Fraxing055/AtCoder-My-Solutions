#include <bits/stdc++.h>
using namespace std;

int main() {
    cin.tie(nullptr);
    ios::sync_with_stdio(false);

    long long N, A, B;
    cin >> N >> A >> B;
    long long ans;
    
    if (A > B) {
      ans = 0;
    } else if (N == 1) {
      ans = (A == B) ? 1 : 0;
    } else if (N == 2) {
      ans = 1;
    } else {
      ans = (B - A + 1) + (N - 3) * (B - A);
    }
    
    cout << ans << endl;

    return 0;
}
